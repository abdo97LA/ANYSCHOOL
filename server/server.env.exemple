# Configuration du serveur UniTimetable (réseau local). Copiez ce fichier en « server.env ».
# AUCUN mot de passe ici : les comptes se créent avec windows\create-admin.ps1 puis dans l'interface.

# Interface d'écoute : 0.0.0.0 = toutes les cartes réseau du PC (nécessaire pour les autres postes).
# Pour limiter à une seule carte, indiquez son adresse IP (ex. 192.168.1.10).
HOST=0.0.0.0
PORT=8787

# Dossiers (chemins relatifs au dossier du serveur, ou absolus)
DATA_DIR=data
# Recommandé : un autre disque, une clé ou un NAS (ex. D:\Sauvegardes\UniTimetable)
BACKUP_DIR=data\backups
LOG_DIR=logs

# Sauvegarde automatique toutes les N heures (0 = désactivée) et nombre de sauvegardes conservées
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Sessions : déconnexion après N minutes d'inactivité, durée maximale en heures
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Verrouillage d'un compte après N échecs, pendant M minutes
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Filtrage réseau optionnel (en plus du pare-feu) : seules ces plages peuvent se connecter.
# ALLOWED_NETWORKS=192.168.1.0/24,127.0.0.1/32

# HTTPS (recommandé) : rempli automatiquement par windows\new-certificate.ps1
# TLS_PFX=certs\unitimetable.pfx
# TLS_PFX_PASSPHRASE=
